generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  firstName    String?
  lastName     String?
  fullName     String?
  name         String?
  email        String?  @unique
  password     String?
  phone        String?  @unique
  googleId     String?  @unique
  profileImage String?
  village      String?
  pincode      String?
  state        String?
  country      String?  @default("India")
  role         String   @default("customer")
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  
  cartItems    CartItem[]
  orders       Order[]
  
  @@map("users")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  
  products Product[]
  
  @@map("categories")
}

model Product {
  id             Int      @id @default(autoincrement())
  category_id    Int?
  name           String
  description    String   @db.Text
  price          Decimal  @db.Decimal(10, 2)
  original_price Decimal? @db.Decimal(10, 2)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  
  category       Category?      @relation(fields: [category_id], references: [id])
  images         ProductImage[]

  @@map("products")
}

model ProductImage {
  id         Int     @id @default(autoincrement())
  product_id Int
  image_url  String
  is_primary Boolean @default(false)
  
  product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  
  @@map("product_images")
}

model CartItem {
  id         Int @id @default(autoincrement())
  user_id    Int
  product_id Int
  quantity   Int @default(1)
  created_at DateTime @default(now())
  
  user       User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  @@map("cart")
}

model Order {
  id               Int         @id @default(autoincrement())
  order_id         String      @unique
  user_id          Int?
  shipping_address Json
  subtotal         Decimal     @db.Decimal(10, 2)
  discount         Decimal     @db.Decimal(10, 2)
  cod_fee          Decimal     @db.Decimal(10, 2)
  total_amount     Decimal     @db.Decimal(10, 2)
  payment_method      String
  payment_status      String      @default("Pending")
  payment_id          String?
  razorpay_order_id   String?
  razorpay_payment_id String?
  razorpay_signature  String?
  capture_timestamp   DateTime?
  transaction_id      String?
  status                String      @default("processing")
  shipping_status       String      @default("pending")
  delhivery_awb         String?
  delhivery_tracking_id String?
  delhivery_shipment_id String?
  delhivery_status      String?     @db.Text
  delhivery_label_url   String?
  tracking_url          String?
  shipment_created_at   DateTime?
  delhivery_created_at  DateTime?
  whatsapp_status    String      @default("pending")
  whatsapp_error   String?     @db.Text
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt
  
  user             User?       @relation(fields: [user_id], references: [id])
  items            OrderItem[]
  
  @@map("orders")
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  order_id     Int
  product_id   Int
  product_name String
  package_size String?
  quantity     Int
  price        Decimal  @db.Decimal(10, 2)
  
  order        Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  
  @@map("order_items")
}

model Setting {
  key        String   @id
  value      String   @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("settings")
}
